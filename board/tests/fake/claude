#!/usr/bin/env python3
"""假 claude：读 stdin 提示词，按 --json-schema 造一个合法对象，吐 stream-json。"""
import json, os, sys, time
args = sys.argv[1:]
sch = json.loads(args[args.index("--json-schema") + 1]) if "--json-schema" in args else {}
prompt = sys.stdin.read()
words = prompt.split("## 用户这一轮的原话")[-1].split("\n## ")[0] if "## 用户这一轮的原话" in prompt else prompt
def fill(s, key=""):
    t = s.get("type"); en = s.get("enum")
    if en: return en[0]
    if "anyOf" in s: return fill(s["anyOf"][-1], key)
    if t == "object":
        return {k: fill(v, k) for k, v in (s.get("properties") or {}).items()}
    if t == "array":
        it = s.get("items") or {"type": "string"}
        if key == "nodes":
            return [{"id": "n1", "goal": "做第一块", "scope": "只改 README", "done_when_ref": "第一条", "files": ["README.md"], "verify": "cat README.md", "depends": []},
                    {"id": "n2", "goal": "做第二块", "scope": "", "done_when_ref": "第一条", "files": ["README.md"], "verify": "cat README.md", "depends": ["n1"]}]
        if key == "decisions": return []
        if key == "done_when": return ["README.md 末尾多一行 hello"]
        if key == "checks": return [{"done_when": "README.md 末尾多一行 hello", "met": True, "evidence": "cat 输出"}]
        return [fill(it, key)] if it.get("type") == "object" else ["x"]
    if t == "integer": return 5
    if t == "boolean": return True
    if t == "null": return None
    if key == "reply": return "（假中书）我把你的话理解成：" + words[:40].strip()
    if key == "status": return "completed"
    return "假内容"
obj = fill(sch)
if "contract" in (sch.get("properties") or {}):
    if "问我一下" in words and ("用户对你上一问的回答" not in prompt or "再问一次也行" in words):
        obj["contract"] = None
        obj["decisions"] = [{"q": "加在文件头还是文件尾？", "opts": ["头", "尾"]}]
    else:
        obj["contract"] = {"goal": "让 README 末尾多一行 hello", "done_when": ["README.md 末尾多一行 hello"], "assumptions": [], "size": "小", "budget": "10 分钟", "not_doing": []}
        obj["decisions"] = []
if "plan_vs_actual" in (sch.get("properties") or {}):
    obj["summary"] = "交付对得上契约，偏差 0 处"
    obj["deviations"] = [{"state": "filled", "content": "多改了一处", "source": "README.md"}] if "御史要挑刺" in prompt else []
if os.environ.get("FAKE_LOG"):                       # 测试要看我是带什么参数被叫起来的
    open(os.environ["FAKE_LOG"], "a").write(" ".join(args) + "\n")
print(json.dumps({"type": "system", "subtype": "init", "model": "fake-claude", "session_id": "s1"}))
def use(tid, name, inp):
    print(json.dumps({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": tid, "name": name, "input": inp}]}}), flush=True)
def result(tid, err=False):
    print(json.dumps({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": tid, "content": "…", "is_error": err}]}}), flush=True)
use("t1", "Read", {"file_path": "README.md"}); result("t1")
if "--permission-mode" in args:
    open("README.md", "a").write("hello\n")
    use("t2", "Edit", {"file_path": "README.md"}); result("t2")
    use("t3", "Bash", {"command": "cat README.md"})       # 停在这里被杀 → 这一条该记成 interrupted
    time.sleep(0.2)
    result("t3", err=True)
else:
    time.sleep(0.2)
print(json.dumps({"type": "result", "subtype": "success", "structured_output": obj, "result": json.dumps(obj)}), flush=True)
if "退出码坏" in words or ("压缩" in prompt[:30] and "压缩要坏" in prompt) or ("御史要坏" in prompt and "plan_vs_actual" in (sch.get("properties") or {})):
    sys.exit(1)                                      # 吐了合法 JSON 之后仍以非零码退出：必须算失败
