#!/usr/bin/env python3
import json, sys
args = sys.argv[1:]
sch = json.load(open(args[args.index("--output-schema") + 1])) if "--output-schema" in args else {}
sys.stdin.read()
def fill(s, key=""):
    t = s.get("type"); en = s.get("enum")
    if en: return en[0]
    if "anyOf" in s: return fill(s["anyOf"][-1], key)
    if t == "object": return {k: fill(v, k) for k, v in (s.get("properties") or {}).items()}
    if t == "array": it = s.get("items") or {"type": "string"}; return [fill(it, key)] if it.get("type") == "object" else ["x"]
    if t == "integer": return 1
    if t == "boolean": return True
    if t == "null": return None
    return "假内容（codex）"
print(json.dumps({"type": "thread.started", "thread_id": "th1"}))
print(json.dumps({"type": "item.started", "item": {"id": "item_0", "type": "command_execution", "command": "sed -n 1,5p README.md", "status": "in_progress"}}))
print(json.dumps({"type": "item.completed", "item": {"id": "item_0", "type": "command_execution", "command": "sed -n 1,5p README.md", "status": "completed", "exit_code": 0}}))
print(json.dumps({"type": "item.completed", "item": {"id": "item_1", "type": "command_execution", "command": "false", "status": "completed", "exit_code": 1}}))
print(json.dumps({"type": "item.completed", "item": {"type": "agent_message", "text": json.dumps(fill(sch))}}))
print(json.dumps({"type": "turn.completed", "usage": {"output_tokens": 1}}))
